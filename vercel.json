{
    "headers": [
        {
            "source": "/",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/index.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/marketplace.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/firebase-messaging-sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/manifest.webmanifest",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=0, must-revalidate"
                }
            ]
        },
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/api-xeiqd/(.*)",
            "destination": "/api/xeiqd?path=$1"
        },
        {
            "source": "/api-xeiqd",
            "destination": "/api/xeiqd"
        },
        {
            "source": "/api-forexfy/(.*)",
            "destination": "/api/forexfy?path=$1"
        },
        {
            "source": "/api-forexfy",
            "destination": "/api/forexfy"
        },
        {
            "source": "/((?!api-xeiqd(?:/|$)|api-forexfy(?:/|$)|assets(?:/|$)|.*\\.[^/]+$).*)",
            "has": [
                {
                    "type": "host",
                    "value": "marketplace-atlas.vercel.app"
                }
            ],
            "destination": "/marketplace.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
